package="ajar"
version="@VERSION@"
os_min_ver="7.0-40761"
arch="noarch"
displayname="Ajar"
description="Your Dahua intercom on your phone, from anywhere, without the manufacturer's cloud. This is the part that runs at home: it talks to the intercom, and the Ajar app talks to it."
maintainer="CODE BLDR S.R.L."
maintainer_url="https://ajar.codebldr.com"
support_url="https://github.com/codebldr/ajar-agent/issues"
helpurl="https://github.com/codebldr/ajar-agent/blob/main/docs/install/synology.md"
thirdparty="yes"
startable="yes"
ctl_stop="yes"
silent_install="no"
silent_upgrade="yes"
install_dep_packages="Node.js_v22"
